#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(150, 200))

    ExecuteClickHuman(708, 177)
    Sleep(Random(80, 120))

    Send("^a")
    Sleep(30)
    Send("{BS}")
    Sleep(Random(40, 80))

    Send("^v")
    Sleep(Random(80, 120))

    ExecuteClickHuman(492, 274)
}

; ========================================================
; CHỨC NĂNG 2: QUÉT VÀ NHẤP TỐC ĐỘ TẤT CẢ CHỮ ĐỎ -> XUẤT ĐƠN -> TẮT POPUP
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 200) ; Nhịp quét nhanh 0.2s
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    x1 := 1023
    y1 := 384
    x2 := 1350
    y2 := 1024

    ; 1. BẤM NÚT SEARCH / TÌM KIẾM TẠI (1443, 309)
    ExecuteClickHuman(1443, 309)
    Sleep(2000) ; Đợi 2 giây cho bảng nạp xong dữ liệu

    ; 2. VÒNG LẶP XỬ LÝ TẤT CẢ DÒNG CHỮ ĐỎ (TỐC ĐỘ CAO)
    Loop {
        hasRedTextThisTurn := false
        
        ; --- QUÉT VÀ TÍCH CHỌN TẤT CẢ DÒNG CHỮ ĐỎ 1 (chu_do1.png) ---
        scanY := y1
        Loop {
            outX1 := 0, outY1 := 0
            if ImageSearch(&outX1, &outY1, x1, scanY, x2, y2, "*85 chu_do1.png") {
                hasRedTextThisTurn := true
                checkboxX1 := outX1 - 700
                checkboxY1 := outY1 + 5
                
                ExecuteClickFast(checkboxX1, checkboxY1) ; Nhấp nhanh
                Sleep(Random(80, 130))
                
                scanY := outY1 + 15 
                if (scanY >= y2) {
                    break
                }
            } else {
                break
            }
        }

        ; --- QUÉT VÀ TÍCH CHỌN TẤT CẢ DÒNG CHỮ ĐỎ 2 (chu_do2.png) ---
        scanY := y1
        Loop {
            outX2 := 0, outY2 := 0
            if ImageSearch(&outX2, &outY2, x1, scanY, x2, y2, "*85 chu_do2.png") {
                hasRedTextThisTurn := true
                checkboxX2 := outX2 - 700
                checkboxY2 := outY2 + 5
                
                ExecuteClickFast(checkboxX2, checkboxY2) ; Nhấp nhanh
                Sleep(Random(80, 130))
                
                scanY := outY2 + 15
                if (scanY >= y2) {
                    break
                }
            } else {
                break
            }
        }

        ; 3. NẾU ĐÃ CHỌN ĐƯỢC CHỮ ĐỎ -> BẤM XUẤT ĐƠN & TẮT POPUP
        if (hasRedTextThisTurn) {
            ; Click nút màu xanh 批量代付 / Xuất đơn (961, 360)
            ExecuteClickHuman(961, 360)
            Sleep(Random(400, 500))

            ; Tắt bảng thông báo xác nhận đầu tiên bằng phím Enter
            Send("{Enter}")
            Sleep(Random(400, 500))

            ; CLICK CHUỘT VÀO NÚT XÁC NHẬN CỦA BẢNG THÔNG BÁO THỨ 2 (976, 613)
            ExecuteClickHuman(976, 613)
            Sleep(Random(400, 500))
        } else {
            break
        }
    }

    ; 4. NGHỈ 1.5 GIÂY TRƯỚC KHI BẮT ĐẦU LƯỢT MỚI
    Sleep(1500)
}

; ========================================================
; HÀM NHẤP CHUỘT
