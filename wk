#Requires AutoHotkey v2.0

; Nhấn phím Back trên chuột (XButton1) để kích hoạt
XButton1:: {
    ; 1. Xóa bộ nhớ tạm và copy vùng đã bôi đen
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return ; Thoát nếu chưa bôi đen hoặc không copy được
    }

    ; 2. Chuyển sang Tab thứ 2 (Ctrl + 2)
    Send("^2")
    Sleep(300)

    ; 3. Nhấp vào ô tìm kiếm (Thay 500, 200 bằng tọa độ thực tế của ô tìm kiếm)
    Click(500, 200)
    Sleep(150)

    ; 4. Dán dữ liệu
    Send("^v")
    Sleep(150)

    ; 5. Click vào nút Tìm kiếm (Thay 650, 200 bằng tọa độ thực tế của nút Tìm kiếm)
    Click(650, 200)
}
