#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(150, 200))

    ExecuteClickHuman(708, 177)
    Sleep(Random(80, 120))

    Send("^a")
    Sleep(30)
    Send("{BS}")
    Sleep(Random(40, 80))

    Send("^v")
    Sleep(Random(80, 120))

    ExecuteClickHuman(492, 274)
}

; ========================================================
; CHỨC NĂNG 2: GỘP CHUNG 1 ẢNH CHỮ ĐỎ -> QUÉT SẠCH TẤT CẢ DÒNG -> XUẤT ĐƠN -> TẮT POPUP
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 200)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    x1 := 1023
    y1 := 384
    x2 := 1350
    y2 := 1024

    ; 1. BẤM NÚT SEARCH / TÌM KIẾM TẠI (1443, 309)
    ExecuteClickHuman(1443, 309)
    Sleep(2000) ; Đợi 2 giây cho bảng nạp xong dữ liệu

    hasFoundRed := false
    scanY := y1

    ; 2. VÒNG LẶP QUÉT VÀ TÍCH CHỌN TẤT CẢ DÒNG CHỮ ĐỎ TỪ TRÊN XUỐNG DƯỚI
    Loop {
        outX := 0, outY := 0
        
        ; Sử dụng *Variation35 để nhận diện linh hoạt mọi độ chênh lệch màu chữ đỏ
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*90 *Variation35 chu_do.png") {
            hasFoundRed := true
            checkboxX := outX - 700
            checkboxY := outY + 5
            
            ExecuteClickFast(checkboxX, checkboxY) ; Tích chọn vào ô vuông
            Sleep(Random(80, 120))
            
            scanY := outY + 15 ; Đẩy vị trí Y xuống dưới 15px để quét tiếp dòng chữ đỏ tiếp theo
            if (scanY >= y2) {
                break
            }
        } else {
            break ; Đã tích chọn sạch toàn bộ dòng chữ đỏ trên màn hình
        }
    }

    ; 3. NẾU CÓ DÒNG CHỮ ĐỎ ĐÃ ĐƯỢC CHỌN -> BẤM XUẤT ĐƠN & TẮT POPUP
    if (hasFoundRed) {
        ; Click nút màu xanh 批量代付 / Xuất đơn (961, 360)
        ExecuteClickHuman(961, 360)
        Sleep(Random(400, 500))

        ; Tắt bảng thông báo xác nhận đầu tiên bằng phím Enter
        Send("{Enter}")
        Sleep(Random(400, 500))

        ; CLICK CHUỘT VÀO NÚT XÁC NHẬN CỦA BẢNG THÔNG BÁO THỨ 2 (976, 613)
        ExecuteClickHuman(976, 613)
        Sleep(Random(400, 500))
    }

    ; 4. NGHỈ 1.5 GIÂY TRƯỚC KHI BẮT ĐẦU LƯỢT MỚI
    Sleep(1500)
}

; ========================================================
; HÀM NHẤP CHUỘT MƯỢT
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 4)
    Sleep(Random(40, 60))
    Click(posX, posY)
    Sleep(Random(40, 60))
}

; ========================================================
; HÀM NHẤP CHUỘT TỐC ĐỘ CAO DÙNG KHI TÍCH Ô CHECKBOX
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 2)
    Sleep(Random(20, 40))
    Click(posX, posY)
    Sleep(Random(30, 50))
}
