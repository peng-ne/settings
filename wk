#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(200, 300))

    ExecuteClickHuman(708, 177)
    Sleep(Random(100, 150))

    Send("^a")
    Sleep(40)
    Send("{BS}")
    Sleep(Random(60, 100))

    Send("^v")
    Sleep(Random(100, 150))

    ExecuteClickHuman(502, 278)
}

; ========================================================
; CHỨC NĂNG 2: TỰ ĐỘNG CHỌN 2 MẪU CHỮ ĐỎ -> XUẤT ĐƠN -> CLICK TẮT 2 POPUP
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 300)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    ; Tọa độ vùng quét cột 渠道 (Chứa chữ màu đỏ)
    x1 := 1023
    y1 := 384
    x2 := 1350
    y2 := 1024

    hasRedText := false

    ; 1. BẤM NÚT SEARCH / TÌM KIẾM TẠI (1443, 309)
    ExecuteClickHuman(1443, 309)
    Sleep(2500) ; Đợi 2.5s cho bảng tải xong dữ liệu hoàn toàn

    ; 2. QUÉT VÀ TÍCH CHỌN CÁC DÒNG CÓ CHỮ MÀU ĐỎ (2 MẪU)
    outX1 := 0, outY1 := 0
    outX2 := 0, outY2 := 0

    ; Quét Mẫu chữ đỏ 1 (chu_do1.png)
    if ImageSearch(&outX1, &outY1, x1, y1, x2, y2, "*85 chu_do1.png") {
        hasRedText := true
        ; Click vào ô checkbox nằm bên trái chữ đỏ 700px (tùy chỉnh lùi lại đúng ô vuông)
        checkboxX := outX1 - 700
        checkboxY := outY1 + 5

        ExecuteClickHuman(checkboxX, checkboxY)
        Sleep(Random(300, 400))
    }

    ; Quét Mẫu chữ đỏ 2 (chu_do2.png)
    if ImageSearch(&outX2, &outY2, x1, y1, x2, y2, "*85 chu_do2.png") {
        hasRedText := true
        checkboxX := outX2 - 700
        checkboxY := outY2 + 5

        ExecuteClickHuman(checkboxX, checkboxY)
        Sleep(Random(300, 400))
    }

    ; 3. NẾU CÓ CHỮ MÀU ĐỎ ĐÃ ĐƯỢC CHỌN -> BẤM XUẤT ĐƠN & TẮT POPUP
    if (hasRedText) {
        ; Click nút màu xanh 批量代付 / Xuất đơn (961, 360)
        ExecuteClickHuman(961, 360)
        Sleep(Random(500, 700))

        ; Tắt bảng thông báo xác nhận đầu tiên bằng phím Enter
        Send("{Enter}")
        Sleep(Random(600, 800))

        ; CLICK CHUỘT VÀO NÚT XÁC NHẬN CỦA BẢNG THÔNG BÁO THỨ 2 (976, 613)
        ExecuteClickHuman(976, 613)
        Sleep(Random(500, 700))
    }

    ; 4. NGHỈ 2 GIÂY TRƯỚC KHI BẮT ĐẦU LƯỢT MỚI
    Sleep(2000)
}

; ========================================================
; HÀM NHẤP CHUỘT TỰ NHIÊN
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 5) ; Tốc độ lướt mượt
    Sleep(Random(40, 70))
    Click(posX, posY)
    Sleep(Random(50, 80))
}
