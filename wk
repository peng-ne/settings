#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(150, 200))

    ExecuteClickFast(723, 170)
    Sleep(Random(80, 120))

    Send("^a")
    Sleep(30)
    Send("{BS}")
    Sleep(Random(40, 80))

    Send("^v")
    Sleep(Random(80, 120))

    ExecuteClickFast(582, 261)
}

; ========================================================
; CHỨC NĂNG 2: BẤM PHẢN HỒI SIÊU NHANH TỪNG Ổ KHÓA
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 150) ; Tăng tần suất quét lên mỗi 0.15 giây (siêu nhạy)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    x1 := 1250
    y1 := 250
    x2 := 1500
    y2 := 850

    foundX := 0
    foundY := 0

    ; 1. QUÉT TÌM Ổ KHÓA LOẠI 1 (okhoa1.png)
    if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*85 okhoa1.png") {
        ExecuteClickFast(foundX + 8, foundY + 8)  ; Click ổ khóa lập tức
        Sleep(Random(100, 150))                   ; Chờ cực ngắn

        ExecuteClickFast(380, 70)                 ; Click Nút Xuất đơn (批量代付)
        Sleep(Random(150, 200))

        Send("{Space}")                           ; Bấm Space 1 lần
        Sleep(Random(150, 200))
        return                                    ; Tiếp tục quét ngay ổ khóa tiếp theo
    }

    ; 2. QUÉT TÌM Ổ KHÓA LOẠI 2 (okhoa2.png) NẾU CÓ
    if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*85 okhoa2.png") {
        ExecuteClickFast(foundX + 8, foundY + 8)  ; Click ổ khóa lập tức
        Sleep(Random(100, 150))                   ; Chờ cực ngắn

        ExecuteClickFast(380, 70)                 ; Click Nút Xuất đơn (批量代付)
        Sleep(Random(150, 200))

        Send("{Space}")                           ; Bấm Space 1 lần
        Sleep(Random(150, 200))
        return                                    ; Tiếp tục quét ngay ổ khóa tiếp theo
    }

    ; 3. KHÔNG CÒN Ổ KHÓA NÀO TRÊN MÀN HÌNH -> CLICK LÀM MỚI VÀ CHỜ 7 GIÂY
    ExecuteClickFast(1495, 195)
    Sleep(7000)
}

; ========================================================
; HÀM NHẤP CHUỘT SIÊU TỐC (Speed 1)
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 1) ; Tốc độ di chuột tối đa (Speed 1)
    Sleep(Random(30, 50))
    Click(posX, posY)
    Sleep(Random(40, 60))
}
