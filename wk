#Requires AutoHotkey v2.0
#SingleInstance Force

global saved_id := ""

; --------------------------------------------------------
; NÚT 1 (Ctrl + Z): COPY ID + CHỤP LAST REGION + CHUYỂN TELEGRAM
; --------------------------------------------------------
^z::
{
    global saved_id
    
    ; 1. Copy ID đang bôi đen
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.5)
    {
        SoundBeep(500, 200)
    }
    saved_id := A_Clipboard
    
    ; 2. Chụp lại vùng cũ (Last Region) qua ShareX (Shift + PrintScreen)
    Send("+{PrintScreen}")
    Sleep(500)
    
    ; 3. Tự động chuyển sang cửa sổ Telegram
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
    }
    
    SoundBeep(750, 100)
}

; --------------------------------------------------------
; NÚT 2 (Ctrl + X): DÁN ẢNH + ID + 456M VÀ GỬI
; --------------------------------------------------------
^x::
{
    global saved_id
    
    if (saved_id == "")
    {
        MsgBox("Bạn chưa bấm Ctrl + Z để copy ID và chụp ảnh!", "Cảnh báo", 48)
        return
    }
    
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
        Sleep(100)
    }
    
    ; Dán ảnh
    Send("^v")
    Sleep(250)
    
    ; Điền ID + 456M
    SendText(saved_id " 456M")
    Sleep(150)
    
    ; Bấm Enter gửi
    Send("{Enter}")
    
    saved_id := ""
    SoundBeep(1200, 150)
}
