#Requires AutoHotkey v2.0

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; PHÍM TẮT F8: BẬT / TẮT TỰ ĐỘNG BÔI TRƠN
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 4000) ; Tự động chạy mỗi 4 giây
        SoundBeep(1500, 190)     ; Âm thanh báo BẬT
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)      ; Âm thanh báo TẮT
    }
}

; ========================================================
; VÒNG LẶP CHÍNH (LIÊN KẾT EDGE + CLICK TỰ NHIÊN)
; ========================================================
MainLoop() {
    ; 1. Bắt buộc kiểm tra cửa sổ Microsoft Edge đang mở và kích hoạt
    if !WinActive("ahk_exe msedge.exe") {
        return
    }

    ; 2. Thực hiện click tự động bôi trơn tại vị trí nút Làm mới (1495, 195)
    ExecuteClick(1495, 195)
}

; ========================================================
; HÀM MÔ PHỎNG THAO TÁC CHUỘT TAY NGƯỜI (TỰ NHIÊN / GIẢM LỖI ZOOM)
; ========================================================
ExecuteClick(posX, posY) {
    ; Tạo độ lệch ngẫu nhiên 1-2 pixel để không bấm trùng 1 điểm tuyệt đối
    randomX := posX + Random(-2, 2)
    randomY := posY + Random(-2, 2)

    ; Di chuyển chuột từ từ (Speed = 12: mượt, tự nhiên trên luồng share Zoom)
    MouseMove(randomX, randomY, 12)
    
    ; Nghỉ ngẫu nhiên mô phỏng phản xạ tay người trước và sau khi click
    Sleep(Random(100, 160))
    Click(randomX, randomY)
    Sleep(Random(120, 180))
}
