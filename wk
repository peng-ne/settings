#Requires AutoHotkey v2.0
#SingleInstance Force

global saved_id := ""

; --------------------------------------------------------
; NÚT 1 (Ctrl + Z): COPY ID + CHỤP LAST REGION + CHUYỂN TELEGRAM
; --------------------------------------------------------
^z::
{
    global saved_id
    
    ; 1. Copy ID đang bôi đen
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.5)
    {
        SoundBeep(500, 200)
    }
    saved_id := A_Clipboard
    
    ; 2. Chụp lại vùng cũ qua ShareX (Shift + PrintScreen)
    Send("+{PrintScreen}")
    Sleep(500)
    
    ; 3. Chuyển sang cửa sổ Telegram
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
    }
    
    SoundBeep(750, 100)
}

; --------------------------------------------------------
; NÚT 2 (Ctrl + X): DÁN ẢNH + ID + 456M (KHÔNG HIỆN MSGBOX, KHÔNG TỰ ENTER)
; --------------------------------------------------------
^x::
{
    global saved_id
    
    ; Nếu chưa copy ID thì bỏ qua, không báo lỗi MsgBox
    if (saved_id == "")
    {
        SoundBeep(400, 150)
        return
    }
    
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
        Sleep(200)
    }
    
    ; 1. Dán ảnh vào cửa sổ chat Telegram
    Send("^v")
    Sleep(600)
    
    ; 2. Đưa chuỗi ID + 456M vào bộ nhớ tạm rồi dán trực tiếp
    A_Clipboard := saved_id " 456M"
    Sleep(100)
    Send("^v")
    
    ; Reset dữ liệu sau khi dán xong (Không bấm Send Enter)
    saved_id := ""
    SoundBeep(1200, 150)
}
