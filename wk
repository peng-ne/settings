#Requires AutoHotkey v2.0
#SingleInstance Force

global saved_id := ""

; --------------------------------------------------------
; NÚT 1 (Ctrl + Z): COPY ID + CHỤP LAST REGION + CHUYỂN TELEGRAM
; --------------------------------------------------------
^z::
{
    global saved_id
    
    ; 1. Copy ID đang bôi đen
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.5)
    {
        SoundBeep(500, 200)
    }
    saved_id := A_Clipboard
    
    ; 2. Chụp lại vùng cũ qua ShareX (Shift + PrintScreen)
    Send("+{PrintScreen}")
    Sleep(500)
    
    ; 3. Chuyển sang cửa sổ Telegram
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
    }
    
    SoundBeep(750, 100)
}

; --------------------------------------------------------
; NÚT 2 (Ctrl + X): DÁN ẢNH + ID + 456M VÀ GỬI (ĐÃ SỬA LỖI)
; --------------------------------------------------------
^x::
{
    global saved_id
    
    if (saved_id == "")
    {
        MsgBox("Bạn chưa bấm Ctrl + Z để copy ID và chụp ảnh!", "Cảnh báo", 48)
        return
    }
    
    if WinExist("ahk_exe Telegram.exe")
    {
        WinActivate("ahk_exe Telegram.exe")
        Sleep(200)
    }
    
    ; 1. Dán ảnh vào cửa sổ chat
    Send("^v")
    
    ; 2. Tăng thời gian chờ (600ms) để Telegram hiện popup/khung preview ảnh và khung Caption sẵn sàng
    Sleep(600)
    
    ; 3. Đưa chuỗi ID + 456M vào bộ nhớ tạm rồi dán trực tiếp (Đảm bảo 100% không bị mất chữ)
    A_Clipboard := saved_id " 456M"
    Sleep(100)
    Send("^v")
    
    ; 4. Đợi dán xong chữ rồi mới gửi
    Sleep(300)
    Send("{Enter}")
    
    ; Reset dữ liệu
    saved_id := ""
    SoundBeep(1200, 150)
}
