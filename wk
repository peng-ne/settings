#Requires AutoHotkey v2.0

; Ép AHK nhận đúng thư mục chứa file script để nạp file ảnh ổ khóa
SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(200, 300))

    ExecuteClick(723, 170)
    Sleep(Random(100, 150))

    Send("^a")
    Sleep(40)
    Send("{BS}")
    Sleep(Random(60, 100))

    Send("^v")
    Sleep(Random(100, 150))

    ExecuteClick(582, 261)
}

; ========================================================
; CHỨC NĂNG 2: MỞ TẤT CẢ Ổ KHÓA + BẤM SPACE -> HẾT KHÓA MỚI CLICK LÀM MỚI
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 300) ; Quét liên tục mỗi 0.3 giây
        SoundBeep(1500, 190)    ; Tiếng bíp báo BẬT
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)     ; Tiếng bíp báo TẮT
    }
}

MainLoop() {
    ; Tọa độ khung vùng quét cột 操作 (X1, Y1, X2, Y2)
    x1 := 1300
    y1 := 250
    x2 := 1480
    y2 := 850

    foundX := 0
    foundY := 0

    ; 1. QUÉT TÌM Ổ KHÓA LOẠI 1 (okhoa1.png)
    if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*80 okhoa1.png") {
        ExecuteClick(foundX + 3, foundY + 3) ; Click thẳng vào tọa độ tìm thấy
        Sleep(Random(250, 350))              ; Chờ cửa sổ hiện lên

        Send("{Space}")                      ; Bấm Space xác nhận mở khóa
        Sleep(Random(300, 400))              ; Chờ cửa sổ đóng lại
        return                               ; Tiếp tục quét ngay khóa tiếp theo
    }

    ; 2. QUÉT TÌM Ổ KHÓA LOẠI 2 (okhoa2.png) NẾU CÓ
    if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*80 okhoa2.png") {
        ExecuteClick(foundX + 3, foundY + 3) ; Click thẳng vào tọa độ tìm thấy
        Sleep(Random(250, 350))              ; Chờ cửa sổ hiện lên

        Send("{Space}")                      ; Bấm Space xác nhận mở khóa
        Sleep(Random(300, 400))              ; Chờ cửa sổ đóng lại
        return                               ; Tiếp tục quét ngay khóa tiếp theo
    }

    ; 3. NẾU KHÔNG CÒN Ổ KHÓA NÀO TRÊN MÀN HÌNH -> CLICK NÚT LÀM MỚI (1495, 195)
    ExecuteClick(1495, 195)
}

; ========================================================
; HÀM NHẤP CHUỘT TỰ NHIÊN (MƯỢT TRÊN ZOOM)
; ========================================================
ExecuteClick(posX, posY) {
    MouseMove(posX, posY, 7)
    Sleep(Random(60, 100))
    Click(posX, posY)
    Sleep(Random(80, 120))
}
