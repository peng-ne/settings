#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(1) {
        return
    }

    Send("^2")
    Sleep(Random(200, 300))

    ExecuteClick(723, 170)
    Sleep(Random(100, 150))

    Send("^a")
    Sleep(40)
    Send("{BS}")
    Sleep(Random(60, 100))

    Send("^v")
    Sleep(Random(100, 150))

    ExecuteClick(582, 261)
}

; ========================================================
; CHỨC NĂNG 2: BẤM TẤT CẢ Ổ KHÓA -> BẤM XUẤT ĐƠN -> BẤM SPACE 1 LẦN -> LÀM MỚI (CHỜ 7S)
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 800)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    x1 := 1250
    y1 := 250
    x2 := 1500
    y2 := 850

    foundX := 0
    foundY := 0
    hasLockedItem := false

    ; 1. BẤM TẤT CẢ Ổ KHÓA HIỆN CÓ TRÊN MÀN HÌNH
    Loop {
        foundInLoop := false

        ; Quét ổ khóa 1
        if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*85 okhoa1.png") {
            hasLockedItem := true
            foundInLoop := true
            ExecuteClick(foundX + 8, foundY + 8)
            Sleep(Random(200, 300))
        }
        ; Quét ổ khóa 2 (nếu có)
        else if ImageSearch(&foundX, &foundY, x1, y1, x2, y2, "*85 okhoa2.png") {
            hasLockedItem := true
            foundInLoop := true
            ExecuteClick(foundX + 8, foundY + 8)
            Sleep(Random(200, 300))
        }

        Sleep(20)

        ; Thoát vòng lặp khi không còn thấy ổ khóa nào
        if (!foundInLoop) {
            break
        }
    }

    ; 2. NẾU VỪA BẤM CÓ Ổ KHÓA: BẤM NÚT XUẤT ĐƠN -> BẤM SPACE 1 LẦN
    if (hasLockedItem) {
        ExecuteClick(380, 70)           ; Tọa độ nút Xuất đơn (批量代付)
        Sleep(Random(400, 500))

        Send("{Space}")                 ; Bấm Space 1 lần xác nhận
        Sleep(Random(400, 500))
    }

    ; 3. BẤM NÚT LÀM MỚI VÀ CHỜ 7 GIÂY CHO TRANG LOAD DỮ LIỆU MỚI
    ExecuteClick(1495, 195)
    Sleep(7000)
}

; ========================================================
; HÀM NHẤP CHUỘT
; ========================================================
ExecuteClick(posX, posY) {
    MouseMove(posX, posY, 4)
    Sleep(Random(80, 120))
    Click(posX, posY)
    Sleep(Random(80, 120))
}
