#Requires AutoHotkey v2.0

; Bôi đen đoạn văn bản trước, sau đó nhấn Ctrl + Shift + E
^+e:: {
    ; 1. Xóa sạch bộ nhớ tạm
    A_Clipboard := ""
    Sleep(50)

    ; 2. Gửi lệnh Copy và chờ dữ liệu mới vào Clipboard
    Send("^c")
    if !ClipWait(1) {
        return ; Bỏ qua nếu không copy được gì
    }

    ; 3. Chuyển sang Tab thứ 2 (Ctrl + 2)
    Send("^2")
    Sleep(300)

    ; 4. Nhấp vào ô tìm kiếm (Thay 500, 200 bằng tọa độ thực tế)
    Click(500, 200)
    Sleep(150)

    ; 5. Xóa sạch nội dung cũ trong ô tìm kiếm
    Send("^a")
    Sleep(50)
    Send("{BS}")
    Sleep(100)

    ; 6. Dán dữ liệu mới
    Send("^v")
    Sleep(150)

    ; 7. Click vào nút Tìm kiếm (Thay 650, 200 bằng tọa độ thực tế)
    Click(650, 200)
}
