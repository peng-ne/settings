#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)
SetMouseDelay(-1) ; Tắt độ trễ mặc định của AHK để tự kiểm soát nhịp Hz chuột

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; ⚙️ CẤU HÌNH TỌA ĐỘ & THỜI GIAN (CHỈNH SỬA TỌA ĐỘ TẠI ĐÂY)
; ========================================================
global CFG_OKHOA_X      := 1767        ; Tọa độ X icon ổ khóa
global CFG_LAMMOI_X     := 1442        ; Tọa độ X nút Làm mới
global CFG_LAMMOI_Y     := 312         ; Tọa độ Y nút Làm mới

global CFG_SCAN_X1      := 910         ; Mép trái vùng quét chữ đỏ
global CFG_SCAN_Y1      := 416         ; Mép trên vùng quét chữ đỏ
global CFG_SCAN_X2      := 1120        ; Mép phải vùng quét chữ đỏ
global CFG_SCAN_Y2      := 1024        ; Mép dưới vùng quét chữ đỏ

global CFG_LOCK_Y_OFFSET:= 8           ; Độ lệch Y vào tâm ổ khóa (+8px)
global CFG_VARIATION    := "*90"       ; Độ lệch màu AHK v2

global CFG_IMG1         := "chu_do1.png"
global CFG_IMG2         := "chu_do2.png"

global isAutoRunningAltA := false
global isAutoRunningAltB := false
global isScriptClicking  := false      ; Cờ phân biệt click của người và của script

; ========================================================
; TÍNH NĂNG DỪNG KHẨN CẤP: DOUBLE-CLICK CHUỘT TRÁI ĐỂ TẮT AUTO
; ========================================================
~LButton:: {
    global isAutoRunningAltA, isAutoRunningAltB, isScriptClicking

    if (isScriptClicking)
        return

    if (A_PriorHotkey = "~LButton" && A_TimeSincePriorHotkey < 400) {
        if (isAutoRunningAltA || isAutoRunningAltB) {
            isAutoRunningAltA := false
            isAutoRunningAltB := false
            SetTimer(MainLoopLock, 0)
            SetTimer(MainLoopLockSlow, 0)
        }
    }
}

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: ALT + A (TỐC ĐỘ NHANH CHUẨN)
; ========================================================
!a:: {
    global isAutoRunningAltA, isAutoRunningAltB

    if isAutoRunningAltB {
        isAutoRunningAltB := false
        SetTimer(MainLoopLockSlow, 0)
    }

    isAutoRunningAltA := !isAutoRunningAltA

    if isAutoRunningAltA {
        SetTimer(MainLoopLock, 100)
    } else {
        SetTimer(MainLoopLock, 0)
    }
}

MainLoopLock() {
    global isAutoRunningAltA
    if (!isAutoRunningAltA)
        return

    ExecuteClickHuman(CFG_LAMMOI_X, CFG_LAMMOI_Y)
    Sleep(Random(1200, 1500))

    Loop {
        if (!isAutoRunningAltA)
            break

        outX := 0, outY := 0
        if ImageSearch(&outX, &outY, CFG_SCAN_X1, CFG_SCAN_Y1, CFG_SCAN_X2, CFG_SCAN_Y2, CFG_VARIATION " " CFG_IMG1)
        || ImageSearch(&outX, &outY, CFG_SCAN_X1, CFG_SCAN_Y1, CFG_SCAN_X2, CFG_SCAN_Y2, CFG_VARIATION " " CFG_IMG2) {
            
            Sleep(Random(100, 150))

            lockX := CFG_OKHOA_X
            lockY := outY + CFG_LOCK_Y_OFFSET

            ExecuteClickFast(lockX, lockY)
            Sleep(Random(30, 60))

            Send("{Space}")
            Sleep(Random(1200, 1500))

            continue
        } else {
            break
        }
    }

    Sleep(400)
}

; ========================================================
; CHỨC NĂNG 3: ALT + B (CHẬM HƠN 50% SO VỚI ALT + A)
; ========================================================
!b:: {
    global isAutoRunningAltA, isAutoRunningAltB

    if isAutoRunningAltA {
        isAutoRunningAltA := false
        SetTimer(MainLoopLock, 0)
    }

    isAutoRunningAltB := !isAutoRunningAltB

    if isAutoRunningAltB {
        SetTimer(MainLoopLockSlow, 150)
    } else {
        SetTimer(MainLoopLockSlow, 0)
    }
}

MainLoopLockSlow() {
    global isAutoRunningAltB
    if (!isAutoRunningAltB)
        return

    ExecuteClickSlow(CFG_LAMMOI_X, CFG_LAMMOI_Y)
    Sleep(Random(1800, 2250))

    Loop {
        if (!isAutoRunningAltB)
            break

        outX := 0, outY := 0
        if ImageSearch(&outX, &outY, CFG_SCAN_X1, CFG_SCAN_Y1, CFG_SCAN_X2, CFG_SCAN_Y2, CFG_VARIATION " " CFG_IMG1)
        || ImageSearch(&outX, &outY, CFG_SCAN_X1, CFG_SCAN_Y1, CFG_SCAN_X2, CFG_SCAN_Y2, CFG_VARIATION " " CFG_IMG2) {
            
            Sleep(Random(150, 225))

            lockX := CFG_OKHOA_X
            lockY := outY + CFG_LOCK_Y_OFFSET

            ExecuteClickSlow(lockX, lockY)
            Sleep(Random(45, 90))

            Send("{Space}")
            Sleep(Random(1800, 2250))

            continue
        } else {
            break
        }
    }

    Sleep(600)
}

; ========================================================
; THUẬT TOÁN DI CHUỘT VẨY NHANH + ĐỘ RUNG TỰ NHIÊN
; ========================================================
HumanMouseMove(targetX, targetY, durationMs) {
    MouseGetPos(&startX, &startY)
    
    dist := Sqrt((targetX - startX)**2 + (targetY - startY)**2)
    if (dist < 4) {
        MouseMove(targetX, targetY, 0)
        return
    }

    arc := Min(dist * 0.08, 28)
    dir := Random(0, 1) ? 1 : -1

    ctrl1X := startX + (targetX - startX) * Random(25, 45) / 100 + Random(-arc, arc) * dir
    ctrl1Y := startY + (targetY - startY) * Random(25, 45) / 100 + Random(-arc, arc) * dir

    ctrl2X := startX + (targetX - startX) * Random(65, 85) / 100 + Random(-arc * 0.4, arc * 0.4) * dir
    ctrl2Y := startY + (targetY - startY) * Random(65, 85) / 100 + Random(-arc * 0.4, arc * 0.4) * dir

    steps := Max(8, Round(durationMs / 4))
    stepDelay := durationMs / steps

    DllCall("QueryPerformanceFrequency", "Int64*", &freq := 0)
    DllCall("QueryPerformanceCounter", "Int64*", &startTick := 0)

    Loop steps {
        t := A_Index / steps
        
        easeT := 1 - (1 - t)**4

        u := 1 - easeT
        tt := easeT * easeT
        uu := u * u
        uuu := uu * u
        ttt := tt * easeT

        curX := uuu * startX + 3 * uu * easeT * ctrl1X + 3 * u * tt * ctrl2X + ttt * targetX
        curY := uuu * startY + 3 * uu * easeT * ctrl1Y + 3 * u * tt * ctrl2Y + ttt * targetY

        if (A_Index < steps - 1) {
            jitter := (1 - easeT) * 0.8
            curX += Random(-jitter, jitter)
            curY += Random(-jitter, jitter)
        }

        MouseMove(Round(curX), Round(curY), 0)
        
        targetTick := startTick + Round((A_Index * stepDelay / 1000) * freq)
        Loop {
            DllCall("QueryPerformanceCounter", "Int64*", &nowTick := 0)
            if (nowTick >= targetTick)
                break
        }
    }

    MouseMove(targetX, targetY, 0)
}

; ========================================================
; HÀM NHẤP CHUỘT (ĐÃ TĂNG TỐC ĐỘ LƯỚT CHUỘT)
; ========================================================
ExecuteClickHuman(posX, posY) {
    global isScriptClicking
    randX := posX + Random(-3, 3)
    randY := posY + Random(-3, 3)

    HumanMouseMove(randX, randY, Random(85, 125))
    Sleep(Random(15, 30))
    
    isScriptClicking := true
    Click("Down")
    Sleep(Random(25, 45))
    Click("Up")
    Sleep(15)
    isScriptClicking := false
    
    Sleep(Random(25, 45))
}

ExecuteClickFast(posX, posY) {
    global isScriptClicking
    randX := posX + Random(-2, 2)
    randY := posY + Random(-2, 2)

    HumanMouseMove(randX, randY, Random(55, 85))
    Sleep(Random(10, 25))
    
    isScriptClicking := true
    Click("Down")
    Sleep(Random(20, 35))
    Click("Up")
    Sleep(15)
    isScriptClicking := false
    
    Sleep(Random(20, 35))
}

ExecuteClickSlow(posX, posY) {
    global isScriptClicking
    randX := posX + Random(-2, 2)
    randY := posY + Random(-2, 2)

    HumanMouseMove(randX, randY, Random(95, 135))
    Sleep(Random(25, 45))
    
    isScriptClicking := true
    Click("Down")
    Sleep(Random(30, 55))
    Click("Up")
    Sleep(15)
    isScriptClicking := false
    
    Sleep(Random(35, 60))
}
