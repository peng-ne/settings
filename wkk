#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: BẤM LÀM MỚI -> CHỌN HẾT DÒNG ĐỎ -> XUẤT ĐƠN -> TẮT POPUP
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 150)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    ; Tọa độ chuẩn vùng quét cột 订单状态 (chứa chữ đỏ "待审核")
    x1 := 910
    y1 := 416
    x2 := 1120
    y2 := 1024

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI (1442, 312)
    ExecuteClickHuman(1442, 312)
    Sleep(1200) ; Đợi 1.2s cho bảng nạp dữ liệu xong

    hasFoundRed := false
    scanY := y1

    ; 2. QUÉT VÀ TÍCH CHỌN TẤT CẢ DÒNG CÓ CHỮ ĐỎ "待审核" TỪ TRÊN XUỐNG DƯỚI
    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do1.png") {
            hasFoundRed := true
            
            ; Tính lùi từ chữ đỏ (X: ~937) về ô vuông Checkbox đầu dòng (X: ~27)
            checkboxX := outX - 910
            checkboxY := outY + 4

            ExecuteClickFast(checkboxX, checkboxY) ; Tích chọn ô vuông
            Sleep(Random(40, 70))

            scanY := outY + 10 ; Nhảy 10px xuống dưới để quét dòng chữ đỏ tiếp theo
            if (scanY >= y2)
                break
        } else {
            break ; Đã tích chọn sạch toàn bộ dòng chữ đỏ trên màn hình
        }
    }

    ; 3. NẾU CÓ DÒNG CHỮ ĐỎ ĐÃ ĐƯỢC CHỌN -> BẤM XUẤT ĐƠN & TẮT POPUP
    if (hasFoundRed) {
        ; Click nút màu xanh 批量代付 / Xuất đơn (Tọa độ nút Xuất đơn chuẩn trên giao diện)
        ExecuteClickHuman(554, 252) ; Hoặc tọa độ nút Xuất đơn xanh dương của bạn
        Sleep(Random(300, 400))

        ; Tắt bảng thông báo xác nhận 1 bằng phím Space
        Send("{Space}")
        Sleep(Random(400, 500))

        ; Click xác nhận bảng thông báo 2 (976, 613)
        ExecuteClickHuman(976, 613)
        Sleep(Random(300, 400))
    }

    ; 4. NGHỈ 1.2 GIÂY TRƯỚC KHI BẮT ĐẦU LƯỢT LÀM MỚI TIẾP THEO
    Sleep(1200)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 3)
    Sleep(Random(30, 50))
    Click(posX, posY)
    Sleep(Random(30, 50))
}

; ========================================================
; HÀM NHẤP CHUỘT SIÊU TỐC
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 1)
    Sleep(Random(15, 30))
    Click(posX, posY)
    Sleep(Random(20, 40))
}
