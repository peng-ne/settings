#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: LÀM MỚI -> QUÉT CHỮ ĐỎ -> TÍCH CHECKBOX -> XUẤT ĐƠN
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunningF8 := false
    isAutoRunningF8 := !isAutoRunningF8

    if isAutoRunningF8 {
        SetTimer(MainLoopBatch, 150)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoopBatch, 0)
        SoundBeep(370, 200)
    }
}

MainLoopBatch() {
    ; Tọa độ chuẩn vùng quét cột 订单状态 (chứa chữ đỏ "待审核")
    x1 := 910
    y1 := 416
    x2 := 1120
    y2 := 1024

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI (1442, 312)
    ExecuteClickHuman(1442, 312)
    Sleep(1200)

    hasFoundRed := false
    scanY := y1

    ; 2. QUÉT VÀ TÍCH CHỌN TẤT CẢ DÒNG CÓ CHỮ ĐỎ (QUÉT CẢ 2 MẪU CHỮ ĐỎ)
    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do2.png") {
            
            hasFoundRed := true
            
            ; Tính lùi từ chữ đỏ (X: ~937) về ô vuông Checkbox đầu dòng (X: ~27)
            checkboxX := outX - 910
            checkboxY := outY + 4

            ExecuteClickFast(checkboxX, checkboxY)
            Sleep(Random(40, 70))

            scanY := outY + 10
            if (scanY >= y2)
                break
        } else {
            break
        }
    }

    ; 3. BẤM XUẤT ĐƠN & TẮT POPUP
    if (hasFoundRed) {
        ExecuteClickHuman(979, 360)
        Sleep(Random(300, 400))

        Send("{Space}")
        Sleep(Random(400, 500))

        ExecuteClickHuman(976, 613)
        Sleep(Random(300, 400))
    }

    Sleep(1000)
}

; ========================================================
; CHỨC NĂNG 3: LÀM MỚI -> QUÉT CHỮ ĐỎ -> BẤM THẲNG Ổ KHÓA (+283 PX)
; Phím tắt: F9 (Bật / Tắt)
; ========================================================
F9:: {
    static isAutoRunningF9 := false
    isAutoRunningF9 := !isAutoRunningF9

    if isAutoRunningF9 {
        SetTimer(MainLoopLock, 150)
        SoundBeep(2000, 190)
    } else {
        SetTimer(MainLoopLock, 0)
        SoundBeep(500, 200)
    }
}

MainLoopLock() {
    x1 := 910
    y1 := 416
    x2 := 1120
    y2 := 1024

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI (1442, 312)
    ExecuteClickHuman(1442, 312)
    Sleep(1200)

    scanY := y1

    ; 2. QUÉT CHỮ ĐỎ VÀ DỊCH CHUYỂN SANG PHẢI BẤM Ổ KHÓA
    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do2.png") {
            
            ; Cộng +283px sang phải từ vị trí chữ đỏ để nhấp vào icon ổ khóa
            lockX := outX + 283
            lockY := outY + 4

            ExecuteClickFast(lockX, lockY)
            Sleep(Random(40, 70))

            Send("{Space}")
            Sleep(Random(150, 250))

            scanY := outY + 10
            if (scanY >= y2)
                break
        } else {
            break
        }
    }

    Sleep(800)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 3)
    Sleep(Random(30, 50))
    Click(posX, posY)
    Sleep(Random(30, 50))
}

; ========================================================
; HÀM NHẤP CHUỘT SIÊU TỐC
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 1)
    Sleep(Random(15, 30))
    Click(posX, posY)
    Sleep(Random(20, 40))
}
