#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: QUÉT CHỮ ĐỎ -> TÍNH TỌA ĐỘ SANG PHẢI CLICK Ổ KHÓA
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 150)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    ; Tọa độ chuẩn xác vùng quét cột 订单状态 (chứa chữ đỏ "待审核")
    x1 := 910
    y1 := 416
    x2 := 1120
    y2 := 1024

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI (Dùng tọa độ nút Tìm kiếm chuẩn trên màn hình của bạn)
    ExecuteClickHuman(1442, 312)
    Sleep(1200)

    scanY := y1

    ; 2. QUÉT CHỮ ĐỎ VÀ CỘNG +283 PX SANG PHẢI ĐỂ BẤM Ổ KHÓA
    Loop {
        outX := 0, outY := 0
        
        ; Quét tìm chữ đỏ chu_do1.png (hoặc chu_do2.png)
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation80 chu_do1.png") {
            
            ; Cộng 283px từ chữ đỏ sang phải để trúng icon ổ khóa
            lockX := outX + 283
            lockY := outY + 4

            ExecuteClickFast(lockX, lockY) ; Bấm thẳng vào ổ khóa
            Sleep(Random(40, 70))

            Send("{Space}") ; Bấm phím Space xác nhận
            Sleep(Random(150, 250))

            scanY := outY + 10 ; Nhảy 10px xuống để quét tiếp dòng dưới
            if (scanY >= y2)
                break
        } else {
            break ; Đã mở sạch ổ khóa
        }
    }

    Sleep(800)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 3)
    Sleep(Random(30, 50))
    Click(posX, posY)
    Sleep(Random(30, 50))
}

; ========================================================
; HÀM NHẤP CHUỘT SIÊU TỐC
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 1)
    Sleep(Random(15, 30))
    Click(posX, posY)
    Sleep(Random(20, 40))
}
