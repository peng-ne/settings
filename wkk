#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(1062, 175)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(30)
    Send("{BS}")
    Sleep(Random(40, 70))

    Send("^v")
    Sleep(Random(60, 100))

    ExecuteClickHuman(878, 274)
}

; ========================================================
; CHỨC NĂNG 2: QUÉT Ổ KHÓA XANH TỐC ĐỘ CAO -> LÀM MỚI TỰ ĐỘNG
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    static isAutoRunning := false
    isAutoRunning := !isAutoRunning

    if isAutoRunning {
        SetTimer(MainLoop, 150) ; Nhịp quét siêu nhanh 0.15s
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoop, 0)
        SoundBeep(370, 200)
    }
}

MainLoop() {
    ; Tọa độ vùng quét cột 操作 (Chứa các icon ổ khóa xanh ngoài cùng bên phải)
    x1 := 1800
    y1 := 416
    x2 := 1910
    y2 := 1025

    ; 1. BẤM NÚT SEARCH / TÌM KIẾM LÀM MỚI TẠI (1825, 312)
    ExecuteClickHuman(1825, 312)
    Sleep(1200) ; Tốc độ tải dữ liệu rút ngắn xuống 1.2s

    scanY := y1

    ; 2. VÒNG LẶP QUÉT VÀ CLICK TẤT CẢ Ổ KHÓA XANH (SIÊU TỐC)
    Loop {
        outX := 0, outY := 0
        
        ; Quét tìm icon okhoa.png
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*80 *Variation40 okhoa.png") {
            lockX := outX + 5
            lockY := outY + 5

            ExecuteClickFast(lockX, lockY) ; Nhấp chuột tốc độ cao vào ổ khóa
            Sleep(Random(40, 70))

            Send("{Space}") ; Bấm phím Space xác nhận ngay lập tức
            Sleep(Random(150, 250))

            scanY := outY + 10 ; Nhảy 10px xuống dưới để quét ổ khóa tiếp theo
            if (scanY >= y2)
                break
        } else {
            break ; Đã mở sạch toàn bộ ổ khóa
        }
    }

    ; 3. NGHỈ ngắn 0.8 GIÂY TRƯỚC KHI BẮT ĐẦU LƯỢT LÀM MỚI TIẾP THEO
    Sleep(800)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT
; ========================================================
ExecuteClickHuman(posX, posY) {
    MouseMove(posX, posY, 3)
    Sleep(Random(30, 50))
    Click(posX, posY)
    Sleep(Random(30, 50))
}

; ========================================================
; HÀM NHẤP CHUỘT SIÊU TỐC (SPEED 1)
; ========================================================
ExecuteClickFast(posX, posY) {
    MouseMove(posX, posY, 1) ; Di chuyển chuột tức thì
    Sleep(Random(15, 30))
    Click(posX, posY)
    Sleep(Random(20, 40))
}
