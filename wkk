#Requires AutoHotkey v2.0
#Notrayicon

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; Biến toàn cục quản lý trạng thái F8, F9 và Alt+E
global isAutoRunningF8 := false
global isAutoRunningF9 := false
global isRunningAltE   := false

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: ALT + E - CLICK LẶP TRỰC TIẾP MỖI 3 GIÂY
; Phím tắt: Alt + E (Bật / Tắt)
; ========================================================
!e:: {
    global isRunningAltE
    isRunningAltE := !isRunningAltE

    if isRunningAltE {
        SetTimer(ClickReloadAltE, 3000)
        SoundBeep(1500, 150)
    } else {
        SetTimer(ClickReloadAltE, 0)
        SoundBeep(400, 150)
    }
}

ClickReloadAltE() {
    ExecuteClickFast(1751, 346)
}

; ========================================================
; CHỨC NĂNG 3: LÀM MỚI -> QUÉT CHỮ ĐỎ -> TÍCH CHECKBOX -> XUẤT ĐƠN
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    global isAutoRunningF8, isAutoRunningF9
    
    ; Tắt F9 nếu đang chạy để tránh xung đột
    if isAutoRunningF9 {
        isAutoRunningF9 := false
        SetTimer(MainLoopLock, 0)
    }

    isAutoRunningF8 := !isAutoRunningF8

    if isAutoRunningF8 {
        SetTimer(MainLoopBatch, 150)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoopBatch, 0)
        SoundBeep(370, 200)
    }
}

MainLoopBatch() {
    x1 := 890
    y1 := 400
    x2 := 1150
    y2 := 1040

    ExecuteClickHuman(1442, 312)
    Sleep(1200)

    hasFoundRed := false
    scanY := y1

    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do2.png") {
            
            hasFoundRed := true
            
            checkboxX := outX - 910
            checkboxY := outY + 4

            ExecuteClickFast(checkboxX, checkboxY)
            Sleep(Random(40, 70))

            scanY := outY + 10
            if (scanY >= y2)
                break
        } else {
            break
        }
    }

    if (hasFoundRed) {
        ExecuteClickHuman(979, 360)
        Sleep(Random(300, 400))

        Send("{Space}")
        Sleep(Random(400, 500))

        ExecuteClickHuman(976, 613)
        Sleep(Random(300, 400))
    }

    Sleep(1000)
}

; ========================================================
; CHỨC NĂNG 4: F9 - CHỜ NẠP 1.5S -> MỞ TỪNG Ổ KHÓA CHUẨN ĐỘ TRỄ -> LÀM MỚI
; Phím tắt: F9 (Bật / Tắt)
; ========================================================
F9:: {
    global isAutoRunningF8, isAutoRunningF9

    ; Tắt F8 nếu đang chạy để tránh xung đột
    if isAutoRunningF8 {
        isAutoRunningF8 := false
        SetTimer(MainLoopBatch, 0)
    }

    isAutoRunningF9 := !isAutoRunningF9

    if isAutoRunningF9 {
        SetTimer(MainLoopLock, 150)
        SoundBeep(2000, 190)
    } else {
        SetTimer(MainLoopLock, 0)
        SoundBeep(500, 200)
    }
}

MainLoopLock() {
    x1 := 890
    y1 := 400
    x2 := 1150
    y2 := 1040

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI TẠI (1442, 312)
    ExecuteClickHuman(1442, 312)
    
    ; Tăng thời gian chờ load bảng sau khi làm mới (1.4s - 1.7s)
    Sleep(Random(1400, 1700))

    ; 2. QUÉT KIỂM TRA ĐẦU VÀO (2 LẦN)
    hasRed := False
    outX := 0, outY := 0
    if ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do1.png")
    || ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do2.png") {
        hasRed := True
    }

    if (!hasRed) {
        Sleep(1000) ; Chờ thêm 1.0s quét lần 2 nếu web nạp chậm
        if ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do2.png") {
            hasRed := True
        }
    }

    if (!hasRed) {
        Sleep(600)
        return
    }

    ; 3. VÒNG LẶP MỞ TẤT CẢ Ổ KHÓA CÒN LẠI RỒI MỚI QUAY LẠI LÀM MỚI
    scanY := y1
    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do2.png") {
            
            Sleep(Random(350, 500))

            lockX := outX + 330
            lockY := outY + 4

            ExecuteClickFast(lockX, lockY)
            Sleep(Random(120, 180))

            Send("{Space}")
            
            ; TĂNG THỜI GIAN CHỜ WEB LOAD XONG TRẠNG THÁI (1.4s - 1.8s)
            Sleep(Random(1400, 1800))

            ; Nhảy 15px xuống dưới dòng vừa xử lý để tìm tiếp dòng dưới
            scanY := outY + 15
            if (scanY >= y2)
                break
        } else {
            break
        }
    }

    Sleep(600)
}

; ========================================================
; CHỨC NĂNG 5: TẮT DỪNG KHẨN CẤP HOÀN TOÀN (TẮT CẢ F8, F9 VÀ ALT+E)
; Phím tắt: F10
; ========================================================
F10:: {
    global isAutoRunningF8, isAutoRunningF9, isRunningAltE
    
    isAutoRunningF8 := false
    isAutoRunningF9 := false
    isRunningAltE   := false

    SetTimer(MainLoopBatch, 0)
    SetTimer(MainLoopLock, 0)
    SetTimer(ClickReloadAltE, 0)

    SoundBeep(400, 150)
    Sleep(50)
    SoundBeep(300, 200)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT (DÙNG CHO CÁC THAO TÁC TỪ TỐN)
; ========================================================
ExecuteClickHuman(posX, posY) {
    randX := posX + Random(-3, 3)
    randY := posY + Random(-3, 3)

    MouseMove(randX, randY, Random(10, 14))
    Sleep(Random(40, 70))
    Click(randX, randY)
    Sleep(Random(40, 70))
}

; ========================================================
; HÀM NHẤP CHUỘT TỰ NHIÊN (TỐC ĐỘ VỪA PHẢI, MƯỢT TRÊN ZOOM)
; ========================================================
ExecuteClickFast(posX, posY) {
    randX := posX + Random(-3, 3)
    randY := posY + Random(-3, 3)

    MouseMove(randX, randY, Random(12, 16))
    Sleep(Random(70, 120))

    Click(randX, randY)

    Sleep(Random(80, 130))
}
