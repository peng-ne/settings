#Requires AutoHotkey v2.0

SetWorkingDir(A_ScriptDir)

CoordMode("Pixel", "Client")
CoordMode("Mouse", "Client")

; Biến toàn cục quản lý trạng thái F8, F9 và Alt+E
global isAutoRunningF8 := false
global isAutoRunningF9 := false
global isRunningAltE   := false

; ========================================================
; CHỨC NĂNG 1: BÔI ĐEN -> COPY -> TAB 2 -> DÁN -> TÌM KIẾM
; Phím tắt: Ctrl + Shift + E
; ========================================================
^+e:: {
    A_Clipboard := ""
    Send("^c")
    if !ClipWait(0.8) {
        return
    }

    Send("^2")
    Sleep(Random(100, 150))

    ExecuteClickHuman(708, 176)
    Sleep(Random(60, 100))

    Send("^a")
    Sleep(20)
    Send("{BS}")
    Sleep(Random(30, 40))

    Send("^v")
    Sleep(Random(20, 30))

    ExecuteClickHuman(494, 273)
}

; ========================================================
; CHỨC NĂNG 2: ALT + E - CLICK LẶP TRỰC TIẾP MỖI 3 GIÂY
; Phím tắt: Alt + E (Bật / Tắt)
; ========================================================
!e:: {
    global isRunningAltE
    isRunningAltE := !isRunningAltE

    if isRunningAltE {
        SetTimer(ClickReloadAltE, 3000)
        SoundBeep(1500, 150)
    } else {
        SetTimer(ClickReloadAltE, 0)
        SoundBeep(400, 150)
    }
}

ClickReloadAltE() {
    ExecuteClickFast(1751, 346)
}

; ========================================================
; CHỨC NĂNG 3: LÀM MỚI -> QUÉT CHỮ ĐỎ -> TÍCH CHECKBOX -> XUẤT ĐƠN
; Phím tắt: F8 (Bật / Tắt)
; ========================================================
F8:: {
    global isAutoRunningF8, isAutoRunningF9
    
    ; Tắt F9 nếu đang chạy để tránh xung đột
    if isAutoRunningF9 {
        isAutoRunningF9 := false
        SetTimer(MainLoopLock, 0)
    }

    isAutoRunningF8 := !isAutoRunningF8

    if isAutoRunningF8 {
        SetTimer(MainLoopBatch, 150)
        SoundBeep(1500, 190)
    } else {
        SetTimer(MainLoopBatch, 0)
        SoundBeep(370, 200)
    }
}

MainLoopBatch() {
    x1 := 890
    y1 := 400
    x2 := 1150
    y2 := 1040

    ExecuteClickHuman(1442, 312)
    Sleep(1200)

    hasFoundRed := false
    scanY := y1

    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do2.png") {
            
            hasFoundRed := true
            
            checkboxX := outX - 910
            checkboxY := outY + 4

            ExecuteClickFast(checkboxX, checkboxY)
            Sleep(Random(40, 70))

            scanY := outY + 10
            if (scanY >= y2)
                break
        } else {
            break
        }
    }

    if (hasFoundRed) {
        ExecuteClickHuman(979, 360)
        Sleep(Random(300, 400))

        Send("{Space}")
        Sleep(Random(400, 500))

        ExecuteClickHuman(976, 613)
        Sleep(Random(300, 400))
    }

    Sleep(1000)
}

; ========================================================
; CHỨC NĂNG 4: F9 - QUÉT 2 LẦN -> MỞ TỪNG Ổ KHÓA TỪ TỐN -> LÀM MỚI
; Phím tắt: F9 (Bật / Tắt)
; ========================================================
F9:: {
    global isAutoRunningF8, isAutoRunningF9

    ; Tắt F8 nếu đang chạy để tránh xung đột
    if isAutoRunningF8 {
        isAutoRunningF8 := false
        SetTimer(MainLoopBatch, 0)
    }

    isAutoRunningF9 := !isAutoRunningF9

    if isAutoRunningF9 {
        SetTimer(MainLoopLock, 150)
        SoundBeep(2000, 190)
    } else {
        SetTimer(MainLoopLock, 0)
        SoundBeep(500, 200)
    }
}

MainLoopLock() {
    x1 := 890
    y1 := 400
    x2 := 1150
    y2 := 1040

    ; 1. BẤM NÚT TÌM KIẾM / LÀM MỚI TẠI (1442, 312)
    ExecuteClickHuman(1442, 312)
    Sleep(800) ; Đợi web bắt đầu nạp dữ liệu

    ; 2. QUÉT KIỂM TRA LẦN 1
    hasRed := False
    outX := 0, outY := 0
    if ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do1.png")
    || ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do2.png") {
        hasRed := True
    }

    ; NẾU LẦN 1 CHƯA THẤY, CHỜ THÊM 0.6s VÀ QUÉT KIỂM TRA LẦN 2
    if (!hasRed) {
        Sleep(600)
        if ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, y1, x2, y2, "*60 *Variation90 chu_do2.png") {
            hasRed := True
        }
    }

    ; NẾU CẢ 2 LẦN ĐỀU KHÔNG THẤY CHỮ ĐỎ -> NGHỈ 0.5s VÀ THOÁT ĐỂ THỰC HIỆN LẦN LÀM MỚI TỚI
    if (!hasRed) {
        Sleep(500)
        return
    }

    ; 3. VÒNG LẶP MỞ TỪNG Ổ KHÓA NẾU PHÁT HIỆN CHỮ ĐỎ
    scanY := y1
    Loop {
        outX := 0, outY := 0
        
        if ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do1.png")
        || ImageSearch(&outX, &outY, x1, scanY, x2, y2, "*60 *Variation90 chu_do2.png") {
            
            ; Tính vị trí icon ổ khóa (+330px sang phải)
            lockX := outX + 330
            lockY := outY + 4

            ; Di chuyển và nhấp chuột vào icon ổ khóa
            ExecuteClickFast(lockX, lockY)
            Sleep(Random(60, 90))

            ; Bấm Space tại vị trí ổ khóa (Chuột giữ nguyên vị trí)
            Send("{Space}")
            
            ; Đợi 0.6s - 0.8s cho web cập nhật xong trạng thái ổ khóa
            Sleep(Random(600, 800))

            ; Reset scanY về y1 để kiểm tra lại từ trên xuống dưới
            scanY := y1 
        } else {
            ; Đã mở sạch chữ đỏ -> Thoát loop để di chuyển chuột quay lại nhấp Làm mới
            break
        }
    }

    Sleep(500)
}

; ========================================================
; CHỨC NĂNG 5: TẮT DỪNG KHẨN CẤP HOÀN TOÀN (TẮT CẢ F8, F9 VÀ ALT+E)
; Phím tắt: F10
; ========================================================
F10:: {
    global isAutoRunningF8, isAutoRunningF9, isRunningAltE
    
    isAutoRunningF8 := false
    isAutoRunningF9 := false
    isRunningAltE   := false

    SetTimer(MainLoopBatch, 0)
    SetTimer(MainLoopLock, 0)
    SetTimer(ClickReloadAltE, 0)

    SoundBeep(400, 150)
    Sleep(50)
    SoundBeep(300, 200)
}

; ========================================================
; HÀM NHẤP CHUỘT CHUẨN MƯỢT (DÙNG CHO CÁC THAO TÁC TỪ TỐN)
; ========================================================
ExecuteClickHuman(posX, posY) {
    randX := posX + Random(-3, 3)
    randY := posY + Random(-3, 3)

    MouseMove(randX, randY, Random(10, 14))
    Sleep(Random(40, 70))
    Click(randX, randY)
    Sleep(Random(40, 70))
}

; ========================================================
; HÀM NHẤP CHUỘT TỰ NHIÊN (TỐC ĐỘ VỪA PHẢI, MƯỢT TRÊN ZOOM)
; ========================================================
ExecuteClickFast(posX, posY) {
    ; 1. Lệch nhẹ tọa độ bấm (±3px) tránh bấm trùng 1 điểm
    randX := posX + Random(-3, 3)
    randY := posY + Random(-3, 3)

    ; 2. Tốc độ di chuyển 12-16 giúp chuột lướt mượt qua Zoom
    MouseMove(randX, randY, Random(12, 16))
    Sleep(Random(70, 120))

    Click(randX, randY)

    ; 3. Nghỉ nhẹ sau khi click
    Sleep(Random(80, 130))
}
